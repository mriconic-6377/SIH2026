# GeoResilience AI — Environment Configuration
# Copy this file to .env and update values

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/georesilience
# Fallback: sqlite:///./georesilience.db (auto-detected if PostgreSQL unavailable)

# Application
APP_NAME=GeoResilience AI
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS (Frontend origin)
FRONTEND_URL=http://localhost:3000

# Simulator
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_NUM_SENSORS=8

# NASA Earthdata / GPM IMERG Satellite Rainfall Access
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_jwt_token_here

# OpenWeatherMap API Key
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
